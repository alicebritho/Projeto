<head>
    <link rel="stylesheet" href="botao_inatividade.css">
</head>

<body>
    <button type="button" class="btn-inativar">Desativar</button>
</body>

.btn-inativar {
    background-color: #dc3545;
    color: #ffffff;
    border: none;
    padding: 10px 20px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
}

.btn-inativar {
    background-color: #b02a37;
}

.btn-inativar:active {
    transform: scale(0.97);
}

